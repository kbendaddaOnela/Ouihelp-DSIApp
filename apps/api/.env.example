# =============================================================================
# apps/api — Variables d'environnement backend
# Copier en .env
# =============================================================================

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

APP_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# --- Module Migration SharePoint Ximi (ONELA -> Ouihelp) ---------------------
# Tenant SharePoint cible : "ouihelp" -> https://ouihelp.sharepoint.com
OUIHELP_SP_TENANT_NAME=
# Par defaut AZURE_TENANT_ID / AZURE_CLIENT_ID si non renseignes
OUIHELP_SP_TENANT_ID=
OUIHELP_SP_CLIENT_ID=
# Certificat de l'app (SharePoint REST refuse l'app-only par secret client)
OUIHELP_SP_CERT_KEY=
OUIHELP_SP_CERT_THUMBPRINT=
# UPN proprietaire des sites crees
OUIHELP_SP_OWNER=
# Optionnels
XIMI_SITE_LCID=1036
XIMI_BATCH_SIZE=4
XIMI_DYNAMIC_GROUP_PATTERN=ONELA - SG-DYN-AG-{TRI}
